{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true
  },
  "contentMappers": [
    { "package": "@vue/content-mapper", "extensions": [".vue"] }
  ],
  "include": ["src"]
}
