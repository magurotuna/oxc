#!/bin/sh
# Fake `tsrs-lint` for the content mapper tests. It acts like a backend that runs the content
# mapper of `src/App.vue` only if `TSRS_LINT_RUN_EXTERNAL_CODE=1` is set, and writes fixed
# protocol frames. Positions are byte offsets in the original files.
payload=$(cat)
dir=$(cd "$(dirname "$0")/../.." && pwd)

# Writes one frame: message type $1, JSON $2.
frame() {
  len=$(printf '%s' "$2" | wc -c | tr -d ' ')
  printf "$(printf '\\%03o\\%03o\\%03o\\%03o\\%03o' $((len % 256)) $((len / 256 % 256)) $((len / 65536 % 256)) $((len / 16777216)) "$1")"
  printf '%s' "$2"
}

# Prints `true` if the payload has a path that ends with $1.
has_path() {
  case "$payload" in *"$1\""*) echo true ;; *) echo false ;; esac
}

vue=$(has_path src/App.vue)
ts=$(has_path src/index.ts)
# `--type-check-only` sends no rules, so a real backend sends no rule reports.
case "$payload" in *'"name":"no-floating-promises"'*) rules=true ;; *) rules=false ;; esac

if [ "$TSRS_LINT_RUN_EXTERNAL_CODE" = "1" ]; then
  if [ "$vue" != true ]; then
    frame 0 '{"error":"fake backend: src/App.vue was not sent with TSRS_LINT_RUN_EXTERNAL_CODE=1"}'
    exit 1
  fi
fi

if [ "$TSRS_LINT_RUN_EXTERNAL_CODE" = "1" ] && [ "$rules" = true ]; then
  # Suppressed by the `eslint-disable-next-line` comment in `<script>`.
  frame 1 '{"kind":0,"range":{"pos":125,"end":131},"rule":"no-floating-promises","message":{"id":"floating","description":"Promises must be awaited.","help":null},"file_path":"'"$dir"'/src/App.vue"}'
  # Has a fix and a suggestion, which Oxlint must not apply in a `.vue` file.
  frame 1 '{"kind":0,"range":{"pos":209,"end":215},"rule":"no-floating-promises","message":{"id":"floating","description":"Promises must be awaited.","help":null},"file_path":"'"$dir"'/src/App.vue","fixes":[{"text":"void ","range":{"pos":209,"end":209}}],"suggestions":[{"message":{"id":"addVoid","description":"Add void operator.","help":null},"fixes":[{"text":"void ","range":{"pos":209,"end":209}}]}]}'
  # A report in `<template>`.
  frame 1 '{"kind":0,"range":{"pos":257,"end":261},"rule":"no-misused-promises","message":{"id":"voidReturn","description":"Promise-returning function provided to attribute where a void return was expected.","help":null},"file_path":"'"$dir"'/src/App.vue","labeled_ranges":[{"label":"This callback has type `() => Promise<void>`.","range":{"pos":257,"end":261}}]}'
elif [ "$TSRS_LINT_RUN_EXTERNAL_CODE" != "1" ]; then
  if [ "$vue" = true ]; then
    frame 0 '{"error":"fake backend: src/App.vue was sent without TSRS_LINT_RUN_EXTERNAL_CODE=1"}'
    exit 1
  fi
  case "$payload" in
    *'"report_notices":true'*)
      notice='{"id":"content-mappers-require-run-external-code","tsconfig":"'"$dir"'/tsconfig.json","extensions":[".vue"]}'
      # Oxlint shows each notice once.
      frame 3 "$notice"
      frame 3 "$notice"
      # Oxlint ignores notices that it does not know.
      frame 3 '{"id":"fake-unknown-notice"}'
      ;;
  esac
fi

if [ "$ts" = true ] && [ "$rules" = true ]; then
  frame 1 '{"kind":0,"range":{"pos":39,"end":44},"rule":"no-floating-promises","message":{"id":"floating","description":"Promises must be awaited.","help":null},"file_path":"'"$dir"'/src/index.ts"}'
fi
