#!/bin/sh
# Fake `tsrs-lint` for files that start with a byte order mark (BOM). Real backends read files
# from disk without the BOM, so their offsets are positions in the text without the BOM. This
# fake does the same: `run()` in `bom.ts` starts at byte 39 without the BOM, and at byte 42 with
# it.
cat >/dev/null
dir=$(cd "$(dirname "$0")/../.." && pwd)

# Writes one frame: message type $1, JSON $2.
frame() {
  len=$(printf '%s' "$2" | wc -c | tr -d ' ')
  printf "$(printf '\\%03o\\%03o\\%03o\\%03o\\%03o' $((len % 256)) $((len / 256 % 256)) $((len / 65536 % 256)) $((len / 16777216)) "$1")"
  printf '%s' "$2"
}

frame 1 '{"kind":0,"range":{"pos":39,"end":44},"rule":"no-floating-promises","message":{"id":"floating","description":"Promises must be awaited.","help":null},"file_path":"'"$dir"'/bom.ts","fixes":[{"text":"void ","range":{"pos":39,"end":39}}],"labeled_ranges":[{"label":"This promise is not handled.","range":{"pos":39,"end":44}}]}'
